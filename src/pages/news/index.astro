---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import NewsCard from '../../components/NewsCard.astro';
import news from '../../data/news.json';
const list = [...news].sort((a, b) => b.date.localeCompare(a.date));
---
<Base title="뉴스" description="캐나다 진출 한국 기업 관련 최신 뉴스">
  <PageBanner title="뉴스" sub="회사 소식" image="/assets/banners/news.jpg" />
  <div class="wrap">
    <p class="meta" style="margin:40px 0 24px">총 {list.length}건</p>
    <div class="grid">{list.map((n) => <NewsCard n={n} />)}</div>
  </div>
</Base>
