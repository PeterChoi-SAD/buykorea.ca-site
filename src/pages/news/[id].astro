---
import Base from '../../layouts/Base.astro';
import news from '../../data/news.json';
import { toHtml, plain, src } from '../../lib.js';
export function getStaticPaths() {
  return news.map((n) => ({ params: { id: String(n.id) }, props: { n } }));
}
const { n } = Astro.props;
---
<Base title={n.title} description={plain(n.body).slice(0, 120)} image={src(n.image)}>
  <div class="wrap">
    <article class="doc">
      <p class="meta">{n.date}</p>
      <h1>{n.title}</h1>
      {n.image && <img class="cover-img" src={src(n.image)} alt={n.title} />}
      <div class="prose" set:html={toHtml(n.body)} />
      {n.source_url && <p><a href={n.source_url} rel="noopener" target="_blank">원문 보기 →</a></p>}
      <a class="back" href="/news/">← 뉴스 목록</a>
    </article>
  </div>
</Base>
