---
import Base from '../layouts/Base.astro';
import VendorCard from '../components/VendorCard.astro';
import NewsCard from '../components/NewsCard.astro';
import site from '../data/site.json';
import vendors from '../data/vendors.json';
import news from '../data/news.json';
const latest = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
---
<Base>
  <section class="hero" style="--hero-bg: url('/assets/uploads/2025/03/home-hero-bg.jpg')">
    <div class="wrap hero-grid">
      <div>
        <h1>{site.tagline}</h1>
        <p>{site.description}</p>
        <div class="btns">
          <a class="btn primary" href="/vendors/">벤더 소개 보기</a>
          <a class="btn ghost" href="/news/">최신 뉴스</a>
        </div>
      </div>
      <img class="poster" src="/assets/uploads/2026/08/beauty.jpg" alt="Canada Beauty Connect 2026" width="360" />
    </div>
  </section>
  <div class="wrap">
    <section class="block">
      <div class="head"><h2>원스톱 캐나다 수출 컨설팅</h2><a class="more" href="/about/">자세히 보기 →</a></div>
      <div class="grid">
        <a class="card pitch" href="/about/"><span class="tag">Marketing</span><h3>캐나다 마케팅</h3><p class="meta">현지 시장에 맞춘 브랜드 소개, 온라인 판매, 홍보 캠페인</p></a>
        <a class="card pitch" href="/about/"><span class="tag">Import</span><h3>수입대행</h3><p class="meta">수입 규정 확인, 통관·물류, 바이어 연결까지 대행</p></a>
        <a class="card pitch" href="/export-support/"><span class="tag">Support</span><h3>수출지원</h3><p class="meta">시장조사부터 지사 운영 자문까지 단계별 지원</p></a>
      </div>
    </section>
    <section class="block">
      <div class="head"><h2>최신 뉴스</h2><a class="more" href="/news/">전체 보기 →</a></div>
      <div class="grid">{latest.map((n) => <NewsCard n={n} />)}</div>
    </section>
    <section class="block">
      <div class="head"><h2>벤더 소개</h2><a class="more" href="/vendors/">전체 보기 →</a></div>
      <div class="grid">{vendors.slice(0, 6).map((v) => <VendorCard v={v} />)}</div>
    </section>
  </div>
</Base>

<style>.pitch { padding: 20px 22px; border-left: 4px solid var(--accent); } .pitch h3 { margin: 10px 0 6px; font-size: 1.12rem; }</style>
