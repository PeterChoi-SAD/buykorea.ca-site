---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="소개">
  <div class="wrap">
    <article class="doc">
      <h1>소개</h1>
      <div class="prose">
        <p>{site.name}는 {site.company}가 운영하는 정보 사이트로, 캐나다 시장 진출을 준비하는 한국 기업(벤더)과 관련 뉴스를 소개합니다.</p>
        {site.contact_email && <p>문의: <a href={`mailto:${site.contact_email}`}>{site.contact_email}</a></p>}
      </div>
    </article>
  </div>
</Base>
