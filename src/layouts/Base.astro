---
import site from '../data/site.json';
const { title, description = site.description, image, canonical } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const full = title ? `${title} | ${site.name}` : `${site.name} - ${site.tagline}`;
const path = Astro.url.pathname;
const nav = [['/news/', '뉴스'], ['/vendors/', '벤더 소개'], ['/export-support/', '수출지원'], ['/about/', '소개']];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%2338b6ff'/><path d='M10 9h7a4 4 0 0 1 1 7.8A4.2 4.2 0 0 1 17.5 25H10z' fill='white'/></svg>" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={site.name}><img src="/assets/logo.png" alt={site.name} height="34" /></a>
        <nav>
          {nav.map(([href, label]) => <a href={href} class:list={{ on: path.startsWith(href) }}>{label}</a>)}
          <a class="cta" href="/contact/">문의하기</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="wrap foot">
        <div>
          <img class="flogo" src="/assets/logo.png" alt={site.name} height="30" />
          <p>{site.tagline}</p>
        </div>
        <div>
          <p><a href={`mailto:${site.contact_email}`}>{site.contact_email}</a></p>
          <p>{site.phone}</p>
          <p>{site.address}</p>
        </div>
        <p class="copy">© {new Date().getFullYear()} {site.company}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --mist: #f3f8fc; --ink: #0c1a2b; --muted: #5d6b7d; --line: #e1e9f1;
    --sky: #38b6ff; --deep: #0a64a8; --navy: #07294a; --radius: 18px;
    --display: 'Poppins', 'Noto Sans KR', sans-serif; --body: 'Noto Sans KR', -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0a1220; --mist: #111b2e; --ink: #eaf1f9; --muted: #9aabc0; --line: #20304a; --sky: #4cbcff; --deep: #7cc9ff; --navy: #07294a; }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.8 var(--body); word-break: keep-all; overflow-wrap: break-word; -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { font-family: var(--display); font-weight: 600; letter-spacing: -.02em; line-height: 1.3; }
  a { color: var(--deep); text-decoration: none; } a:hover { text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--sky); outline-offset: 3px; border-radius: 6px; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

  .top { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .brand img { display: block; height: 34px; width: auto; }
  nav { display: flex; align-items: center; gap: 4px; }
  nav a { color: var(--ink); font-weight: 500; font-size: .95rem; padding: 8px 14px; border-radius: 999px; }
  nav a:hover { background: var(--mist); text-decoration: none; }
  nav a.on { color: var(--deep); background: var(--mist); }
  nav a.cta { background: var(--ink); color: var(--bg); margin-left: 10px; padding: 9px 20px; }
  nav a.cta:hover { background: var(--deep); color: #fff; }

  .hero { color: #fff; background: linear-gradient(100deg, rgba(5,32,60,.96) 0%, rgba(8,70,120,.86) 55%, rgba(56,182,255,.55) 130%), var(--hero-bg, none) center/cover; }
  .hero-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 56px; align-items: center; padding-top: 104px; padding-bottom: 104px; }
  .hero h1 { margin: 0 0 20px; font-size: clamp(2rem, 4.6vw, 3.4rem); line-height: 1.22; letter-spacing: -.03em; font-weight: 600; }
  .hero p { margin: 0 0 32px; max-width: 520px; color: rgba(255,255,255,.82); font-size: 1.08rem; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 13px 26px; border-radius: 999px; font-weight: 500; font-size: .98rem; transition: background .2s, color .2s; }
  .btn:hover { text-decoration: none; }
  .btn.primary { background: #fff; color: var(--navy); } .btn.primary:hover { background: var(--sky); color: #04223e; }
  .btn.ghost { border: 1px solid rgba(255,255,255,.55); color: #fff; } .btn.ghost:hover { background: rgba(255,255,255,.12); }
  .btn.solid { background: var(--ink); color: var(--bg); } .btn.solid:hover { background: var(--deep); color: #fff; }
  .poster { width: 320px; max-width: 100%; height: auto; justify-self: end; border-radius: var(--radius); box-shadow: 0 30px 60px -20px rgba(0,0,0,.5); }

  .pbanner { background: linear-gradient(100deg, rgba(5,32,60,.9) 0%, rgba(8,70,120,.6) 60%, rgba(8,70,120,.25) 100%), var(--bn) center/cover; color: #fff; }
  .pbanner .wrap { padding-top: 88px; padding-bottom: 88px; }
  .pbanner h1 { margin: 0; font-size: clamp(2rem, 4.5vw, 3rem); }
  .pbanner p { margin: 10px 0 0; color: rgba(255,255,255,.85); font-size: 1.08rem; }

  section.block { padding: 72px 0 0; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 28px; }
  .head h2 { margin: 0; font-size: 1.7rem; }
  .more { font-size: .95rem; font-weight: 500; white-space: nowrap; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 40px 28px; }

  .card { display: block; color: var(--ink); }
  .card:hover { text-decoration: none; }
  .card .th { aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; background: var(--mist); display: flex; align-items: center; justify-content: center; padding: 18px; border: 1px solid var(--line); }
  .card .th.cover { padding: 0; border: 0; } .card .th.cover img { width: 100%; height: 100%; object-fit: cover; }
  .card .th img { max-width: 100%; max-height: 100%; object-fit: contain; transition: transform .5s ease; }
  .card:hover .th img { transform: scale(1.04); }
  .card .cb { padding: 16px 2px 0; } .card h3 { margin: 4px 0 4px; font-size: 1.1rem; line-height: 1.45; }
  .card:hover h3 { color: var(--deep); }
  .meta { color: var(--muted); font-size: .9rem; margin: 0; }
  .tag { display: inline-block; font-size: .8rem; font-weight: 500; color: var(--deep); background: color-mix(in srgb, var(--sky) 16%, transparent); border-radius: 999px; padding: 1px 12px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 32px; }

  .col { border-top: 1px solid var(--ink); padding-top: 20px; }
  .col h3 { margin: 0 0 8px; font-size: 1.2rem; } .col p { margin: 0; color: var(--muted); }
  .col ul { margin: 14px 0 0; padding-left: 18px; } .col li { margin: 2px 0; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px 36px; }

  article.doc { max-width: 760px; margin: 0 auto; padding: 64px 0 24px; }
  article.doc h1 { font-size: clamp(1.7rem, 3.6vw, 2.3rem); margin: 10px 0 22px; }
  .cover-img { width: 100%; border-radius: var(--radius); margin: 4px 0 24px; }
  .logo-img { max-height: 110px; max-width: 280px; background: #fff; padding: 12px; border: 1px solid var(--line); border-radius: var(--radius); margin: 4px 0 18px; }
  .prose img { max-width: 100%; border-radius: 12px; } .prose p { margin: 0 0 1.1em; } .prose { font-size: 1.04rem; }
  .rows { margin: 28px 0; border-top: 1px solid var(--ink); }
  .rows > div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .rows dt { color: var(--muted); font-size: .92rem; } .rows dd { margin: 0; }
  .back { display: inline-block; margin-top: 14px; font-weight: 500; }

  footer { margin-top: 112px; background: var(--mist); }
  .foot { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px 48px; padding-top: 56px; padding-bottom: 40px; font-size: .95rem; }
  .foot p { margin: 0 0 4px; color: var(--muted); } .flogo { display: block; height: 30px; width: auto; margin-bottom: 12px; }
  .foot .copy { grid-column: 1 / -1; padding-top: 24px; border-top: 1px solid var(--line); font-size: .85rem; }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; padding-top: 64px; padding-bottom: 64px; } .poster { width: 240px; justify-self: start; }
    .bar { height: 64px; } nav a { padding: 7px 10px; font-size: .88rem; } nav a.cta { margin-left: 4px; padding: 7px 14px; }
    .pbanner .wrap { padding-top: 56px; padding-bottom: 56px; } section.block { padding-top: 52px; } .foot { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .bar { height: auto; flex-wrap: wrap; padding-top: 10px; padding-bottom: 6px; } nav { width: 100%; order: 3; overflow-x: auto; gap: 2px; margin: 4px -10px 0; padding: 0 10px 4px; } nav a { white-space: nowrap; padding: 7px 8px; font-size: .86rem; } nav a.cta { margin-left: auto; padding: 7px 12px; } }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } html { scroll-behavior: auto; } }
</style>
