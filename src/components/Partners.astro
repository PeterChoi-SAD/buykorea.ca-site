---
const partners = [
  ['okta', 'World-OKTA Vancouver'], ['kingdom', 'Kingdom Beauty Supplies'], ['anvely', 'Anvely Cosmetics & Fashion'], ['stacking', 'Stacking Korea'],
  ['housecook', 'Hauscook'], ['dandy', 'Dan-D Pak'], ['hannam', 'Hannam'], ['east', '東立'],
  ['kjoa', 'K-JOA'], ['samboo', '삼보죽염'], ['junju', '전주비빔밥'], ['morning', '모닝아트'],
];
const { title = '함께하는 기업', sub } = Astro.props;
---
<section class="block">
  <div class="head"><h2>{title}</h2>{sub && <span class="meta">{sub}</span>}</div>
  <ul class="plogos">
    {partners.map(([k, n]) => <li><img src={`/assets/partners/${k}.jpg`} alt={n} loading="lazy" /></li>)}
  </ul>
</section>
<style>
  .plogos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
  .plogos li { aspect-ratio: 16 / 9; background: #fff; border: 1px solid var(--line); border-radius: 14px; display: flex; align-items: center; justify-content: center; padding: 14px; }
  .plogos img { max-width: 100%; max-height: 100%; object-fit: contain; filter: grayscale(1); opacity: .75; transition: filter .3s, opacity .3s; }
  .plogos li:hover img { filter: none; opacity: 1; }
</style>
